{
  "name": "creative-writer",
  "version": "0.8.0",
  "description": "Zen Mode, typewriter centering, focus fade and paragraph rhythm for creative writing in Obsidian.",
  "main": "main.js",
  "type": "module",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "npm run typecheck && node esbuild.config.mjs production",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc -noEmit -skipLibCheck && tsc -noEmit -skipLibCheck -p tsconfig.test.json",
    "lint": "npm run lint:ts && npm run lint:css",
    "lint:ts": "eslint src --max-warnings 0",
    "lint:css": "stylelint styles.css",
    "install:vault": "node scripts/install-to-vault.mjs",
    "build:concreteness": "node scripts/build-concreteness.mjs",
    "eval": "vitest run tests/eval",
    "eval:ollama": "OLLAMA_LIVE=1 vitest run tests/eval/model",
    "version": "node scripts/version-bump.mjs && git add manifest.json versions.json",
    "release:check": "npm run lint && npm run build && npm test && node -e \"const m=require('./manifest.json'),p=require('./package.json');if(m.version!==p.version)throw new Error('manifest/package version mismatch')\"",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs"
  },
  "keywords": [
    "obsidian",
    "plugin",
    "writing",
    "zen"
  ],
  "license": "MIT",
  "devDependencies": {
    "@codemirror/language": "^6.10.0",
    "@codemirror/state": "6.5.0",
    "@codemirror/view": "^6.26.0",
    "@eslint/js": "^9.39.5",
    "@types/node": "^20.11.0",
    "@vitest/coverage-v8": "^2.1.0",
    "esbuild": "^0.23.0",
    "eslint": "^9.39.5",
    "eslint-plugin-obsidianmd": "^0.4.2",
    "jsdom": "^25.0.0",
    "obsidian": "latest",
    "stylelint": "^16.26.1",
    "stylelint-no-unsupported-browser-features": "^8.1.1",
    "tslib": "^2.6.0",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8.69.0",
    "vitepress": "^1.6.4",
    "vitest": "^2.1.0"
  },
  "dependencies": {
    "compromise": "^14.16.0"
  },
  "engines": {
    "node": ">=20"
  }
}
